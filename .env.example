# Variables pour docker-compose.yml (PostgreSQL + Keycloak + Backend +
# Frontend, voir ce fichier pour le détail complet). Copier en `.env`
# (déjà ignoré par .gitignore) et renseigner de vraies valeurs locales —
# ne jamais commiter de valeur réelle ici.

DB_USERNAME=loadpilot
DB_PASSWORD=<mot-de-passe-local-a-choisir>
DB_NAME=loadpilot

KEYCLOAK_ADMIN_PASSWORD=<mot-de-passe-local-a-choisir>

# Master prompt final (Lot E) — requis par le service "backend" du compose.
# Généré par Keycloak à l'IMPORT du réalm (jamais connu à l'avance) :
# démarrer `docker compose up -d keycloak` d'abord, récupérer ce secret
# dans la Console Admin (Clients → loadpilot-backend-admin → Credentials →
# Regenerate), puis le renseigner ici avant `docker compose up -d` complet.
KEYCLOAK_ADMIN_CLIENT_SECRET=<recupere-dans-la-console-admin-keycloak-apres-import>

# Cle de chiffrement des secrets des applications testees en base (AES-256, 32 octets en Base64).
# Obligatoire : sans elle le backend refuse de demarrer. A generer une fois, a ne jamais perdre
# (les secrets deja chiffres deviendraient illisibles) - voir docs/SECRETS.md.
LOADPILOT_SECRETS_KEY=<cle-de-32-octets-en-base64>

# ------------------------------------------------------------------
# Application cible : à remplir seulement si elle l'exige (sinon laisser
# commenté). Lues par backend/start.sh (Docker) et backend/start.ps1 (lancement
# local : définir les mêmes noms dans le terminal, ex. $env:LOADPILOT_JVM_MAX_MEMORY='6g').
# Voir README, « Préparer LoadPilot pour une application cible inconnue ».
# ------------------------------------------------------------------

# Mémoire maximale du backend (défaut 4g). À augmenter pour un test long ou à fort débit.
# LOADPILOT_JVM_MAX_MEMORY=[6g]

# Délai de réponse d'une requête pendant un test (défaut 10 s). Si la cible répond lentement.
# EXECUTION_TIMEOUT_SECONDS=[30]

# Certificat de l'application signé par une autorité INTERNE (erreur « PKIX path building failed »).
# Magasin qui REMPLACE celui de Java : il doit contenir aussi les autorités publiques (voir README).
# Docker : chemin vu dans le conteneur (/opt/loadpilot/certs/...).
# LOADPILOT_TLS_TRUSTSTORE_PATH=[/opt/loadpilot/certs/truststore.p12]
# LOADPILOT_TLS_TRUSTSTORE_PASSWORD=[mot-de-passe-du-truststore]

# Certificat CLIENT exigé par l'application (authentification mutuelle, « bad_certificate »).
# LOADPILOT_TLS_KEYSTORE_PATH=[/opt/loadpilot/certs/client.p12]
# LOADPILOT_TLS_KEYSTORE_PASSWORD=[mot-de-passe-du-certificat-client]

# Proxy sortant obligatoire pour joindre l'application (réseau d'entreprise). Hôte et port ensemble.
# LOADPILOT_HTTPS_PROXY_HOST=[proxy.exemple.local]
# LOADPILOT_HTTPS_PROXY_PORT=[8080]

# Identifiant du proxy, si le proxy répond « 407 Proxy Authentication Required ». Basic uniquement
# (pas de NTLM / Kerberos). Les deux ensemble, et avec l'hôte et le port du proxy ci-dessus.
# LOADPILOT_HTTPS_PROXY_USERNAME=[identifiant-proxy]
# LOADPILOT_HTTPS_PROXY_PASSWORD=[mot-de-passe-proxy]

# ------------------------------------------------------------------
# Tester les purges en local sans attendre (JAMAIS en production : les *_RETENTION_OVERRIDE
# font refuser le démarrage en profil prod). Supprime réellement les données plus anciennes :
# sauvegarder la base avant. Crons sur 6 champs (secondes d'abord) ; durées avec leur unité
# (10m, 2h, 3d), utilisées par la purge à la place de Paramètres > Système.
# ------------------------------------------------------------------
# LOADPILOT_AUDIT_PURGE_CRON=[30 */2 * * * *]
# LOADPILOT_RESULTS_PURGE_CRON=[0 */2 * * * *]
# LOADPILOT_AUDIT_RETENTION_OVERRIDE=[10m]
# LOADPILOT_RESULTS_RETENTION_OVERRIDE=[30m]
# LOADPILOT_REQUEST_DETAILS_RETENTION_OVERRIDE=[10m]

# Serveur d'e-mails de Keycloak (mot de passe oublié…). Laisser commenté en
# développement / démo : les e-mails partent vers Mailpit (http://localhost:8025).
# En production, décommenter et renseigner le vrai serveur SMTP :
# KC_SMTP_HOST=smtp.exemple.com
# KC_SMTP_PORT=587
# KC_SMTP_FROM=no-reply@exemple.com
# KC_SMTP_FROM_NAME=LoadPilot
# KC_SMTP_STARTTLS=true
# KC_SMTP_SSL=false
# KC_SMTP_AUTH=true
# KC_SMTP_USER=<utilisateur-smtp>
# KC_SMTP_PASSWORD=<mot-de-passe-smtp>

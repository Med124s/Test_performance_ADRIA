# Variables pour docker-compose.yml (PostgreSQL + Keycloak + Backend +
# Frontend, voir ce fichier pour le détail complet). Copier en `.env`
# (déjà ignoré par .gitignore) et renseigner de vraies valeurs locales —
# ne jamais commiter de valeur réelle ici.

DB_USERNAME=loadpilot
DB_PASSWORD=<mot-de-passe-local-a-choisir>
DB_NAME=loadpilot

KEYCLOAK_ADMIN_PASSWORD=<mot-de-passe-local-a-choisir>

# Master prompt final (Lot E) — requis par le service "backend" du compose.
# Généré par Keycloak à l'IMPORT du réalm (jamais connu à l'avance) :
# démarrer `docker compose up -d keycloak` d'abord, récupérer ce secret
# dans la Console Admin (Clients → loadpilot-backend-admin → Credentials →
# Regenerate), puis le renseigner ici avant `docker compose up -d` complet.
KEYCLOAK_ADMIN_CLIENT_SECRET=<recupere-dans-la-console-admin-keycloak-apres-import>

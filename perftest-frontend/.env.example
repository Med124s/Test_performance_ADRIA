# Keycloak — authentification réelle (voir keycloak/README.md pour une
# procédure de démarrage reproductible sans Docker).
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=loadpilot
VITE_KEYCLOAK_CLIENT_ID=loadpilot-frontend

# Backend Spring Boot réel — source de vérité unique pour Applications/
# Scénarios/Steps/Exécutions/Historique/Rapports/Métriques/Notifications/
# Scheduling/Audit/Users.
VITE_SPRING_API_URL=http://localhost:8080

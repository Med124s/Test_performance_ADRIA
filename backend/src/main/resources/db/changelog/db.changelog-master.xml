<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Changelog maitre.

        Phase 3 : demarre volontairement vide (aucune entite metier).
        Phase 5 : premiere table reelle, app_user (voir entity.AppUser) -
        projection locale d'un utilisateur Keycloak, aucun mot de passe.
        Phase 6 : table application (cible testee), FK vers app_user.
        Phase 7 : table scenario, FK vers application et app_user.
        Phase 8 : table step, FK vers scenario.
        Phase 9 : tables execution et execution_step_result.
        Phase 10 : table metric.
        Phase 12 : table audit_log.

        A partir des phases suivantes, chaque nouvelle ressource ajoutera
        son propre fichier sous changes/ et sera reference ici via
        <include>.
    -->

    <include file="db/changelog/changes/001-create-app-user.xml"/>
    <include file="db/changelog/changes/002-create-application.xml"/>
    <include file="db/changelog/changes/003-create-scenario.xml"/>
    <include file="db/changelog/changes/004-create-step.xml"/>
    <include file="db/changelog/changes/005-create-execution.xml"/>
    <include file="db/changelog/changes/006-create-execution-step-result.xml"/>
    <include file="db/changelog/changes/007-create-metric.xml"/>
    <include file="db/changelog/changes/008-create-audit-log.xml"/>

    <!--
        Phase 30 : suppression du monitoring systeme (CPU/RAM/Disk/Network) -
        voir changes/009-drop-monitoring-columns.xml. Les vraies metriques de
        performance (responseTime/statusCode/throughput/errorRate) restent
        inchangees.
    -->
    <include file="db/changelog/changes/009-drop-monitoring-columns.xml"/>

    <!--
        Phase P0-A : vrai moteur de charge - parametres de charge reels sur
        scenario/execution (voir changes/010-add-load-test-parameters.xml).
    -->
    <include file="db/changelog/changes/010-add-load-test-parameters.xml"/>

    <!--
        Phase P1-B : Notifications & Scheduling reels - tables notification/
        scheduled_execution, et colonne execution.triggered_by_app_user_id
        (voir changes/011-create-notification-and-scheduled-execution.xml).
    -->
    <include file="db/changelog/changes/011-create-notification-and-scheduled-execution.xml"/>

    <!--
        Phase P1-D : preference de fuseau horaire sur app_user, et table
        notification_preference (voir changes/012-add-app-user-timezone-
        and-notification-preference.xml).
    -->
    <include file="db/changelog/changes/012-add-app-user-timezone-and-notification-preference.xml"/>

    <!--
        Phase P1-Q Etape B : options d'execution justifiees par decision
        produit (variables/CSV data source, assertion de contenu simple,
        think time/timeout/follow-redirects PAR ETAPE) - colonnes
        additionnelles nullables sur step/scenario (voir changes/
        013-add-step-engine-options.xml). Pacing/target-rate et variables
        dynamiques capturees d'une reponse restent une decision produit non
        tranchee (voir rapport) - aucune colonne ajoutee pour elles ici.
    -->
    <include file="db/changelog/changes/013-add-step-engine-options.xml"/>

    <!--
        Master prompt final (Lots A/B) : pacing (debit cible optionnel par
        Scenario) et capture de variable dynamique depuis la reponse d'une
        etape (voir changes/014-add-pacing-and-variable-capture.xml).
    -->
    <include file="db/changelog/changes/014-add-pacing-and-variable-capture.xml"/>

    <!--
        Authentification de l'Application cible (Bearer, cle API, Basic,
        login automatique) - voir changes/015-add-application-authentication.xml.
    -->
    <include file="db/changelog/changes/015-add-application-authentication.xml"/>

    <!--
        Message et date du dernier test de connectivite d'une Application -
        voir changes/016-add-application-status-message.xml.
    -->
    <include file="db/changelog/changes/016-add-application-status-message.xml"/>

    <!--
        Suppression coherente : copie de l'etape dans les resultats (FK ON
        DELETE SET NULL) et archivage logique des applications/scenarios -
        voir changes/017-deletion-history-and-archiving.xml.
    -->
    <include file="db/changelog/changes/017-deletion-history-and-archiving.xml"/>

    <!--
        Brouillons de scenario (statut DRAFT remplacant INACTIVE, etape atteinte, etat de
        l'assistant) et colonne csv_data elargie - voir changes/018-scenario-drafts-and-csv-size.xml.
    -->
    <include file="db/changelog/changes/018-scenario-drafts-and-csv-size.xml"/>

    <!--
        Statut INACTIVE fonctionnel : planifications suspendues par la desactivation du
        scenario - voir changes/019-scenario-inactive-paused-schedules.xml.
    -->
    <include file="db/changelog/changes/019-scenario-inactive-paused-schedules.xml"/>

    <!--
        Variables du scenario, distribution du CSV, parametres de chemin/requete des etapes et
        tracabilite VU/iteration/URL finale des resultats - voir changes/020-variables-and-request-params.xml.
    -->
    <include file="db/changelog/changes/020-variables-and-request-params.xml"/>
    <!--
        Pause / reprise d'une execution - voir changes/021-execution-pause.xml.
    -->
    <include file="db/changelog/changes/021-execution-pause.xml"/>
    <!--
        Index sur execution_id (resultats, metriques) - voir changes/022-execution-foreign-key-indexes.xml.
    -->
    <include file="db/changelog/changes/022-execution-foreign-key-indexes.xml"/>
    <!--
        Detail des requetes d'une execution (echecs + echantillon) - voir changes/023-execution-request-detail.xml.
    -->
    <include file="db/changelog/changes/023-execution-request-detail.xml"/>
    <!--
        Chronologie d'une execution (VU actifs, pauses) - voir changes/024-execution-timeline.xml.
    -->
    <include file="db/changelog/changes/024-execution-timeline.xml"/>
    <!--
        Monitoring CPU / RAM de l'application testee - voir changes/025-application-monitoring.xml.
    -->
    <include file="db/changelog/changes/025-application-monitoring.xml"/>
    <!--
        Resume par execution (P95, debit, P95 par etape) et index pour le Dashboard - voir changes/026-execution-stats-dashboard.xml.
    -->
    <include file="db/changelog/changes/026-execution-stats-dashboard.xml"/>
    <!--
        Index (execution, temps de reponse) : requetes extremes et tri - voir changes/027-result-response-time-index.xml.
    -->
    <include file="db/changelog/changes/027-result-response-time-index.xml"/>
    <!--
        Planification : historique (execution.schedule_id, lancements ignores / manques), date de fin,
        mode de notification - voir changes/028-schedule-history-and-rules.xml.
    -->
    <include file="db/changelog/changes/028-schedule-history-and-rules.xml"/>
    <!--
        Seuils de reussite par scenario et statut THRESHOLDS_EXCEEDED - voir changes/029-success-thresholds.xml.
    -->
    <include file="db/changelog/changes/029-success-thresholds.xml"/>

    <!--
        Journal d'audit enrichi (acteur, objet, avant/apres, evenements de securite) et reglages - voir changes/030-audit-enrichment-and-settings.xml.
    -->
    <include file="db/changelog/changes/030-audit-enrichment-and-settings.xml"/>

    <!--
        Conservation des resultats detailles (rapport fige, option « Conserver », dates de purge) - voir changes/031-results-retention.xml.
    -->
    <include file="db/changelog/changes/031-results-retention.xml"/>

    <!--
        Preferences du profil (apparence, notifications par e-mail) - voir changes/032-profile-preferences.xml.
    -->
    <include file="db/changelog/changes/032-profile-preferences.xml"/>

    <!--
        Secrets des applications testees chiffres en base (cle LOADPILOT_SECRETS_KEY) - voir
        changes/033-encrypt-application-secrets.xml et docs/SECRETS.md.
    -->
    <include file="db/changelog/changes/033-encrypt-application-secrets.xml"/>

    <!--
        Capture depuis un en-tete de reponse (source JSON ou HEADER) - voir changes/034-step-capture-source.xml.
    -->
    <include file="db/changelog/changes/034-step-capture-source.xml"/>

    <!--
        Frein automatique sur taux d'erreurs en direct (desactive par defaut) - voir changes/035-scenario-error-rate-brake.xml.
    -->
    <include file="db/changelog/changes/035-scenario-error-rate-brake.xml"/>

    <!--
        Ralentissement sur 429 Too Many Requests (actif par defaut) - voir changes/036-scenario-throttle-429.xml.
    -->
    <include file="db/changelog/changes/036-scenario-throttle-429.xml"/>

    <!--
        Proxy par application, mot de passe chiffre - voir changes/037-application-proxy.xml.
    -->
    <include file="db/changelog/changes/037-application-proxy.xml"/>

    <!--
        Variation aleatoire du think time (desactivee par defaut) - voir changes/038-scenario-think-time-variation.xml.
    -->
    <include file="db/changelog/changes/038-scenario-think-time-variation.xml"/>

    <!--
        Controles optionnels d'une etape (temps de reponse maximal, assertion JSON) - voir changes/039-step-response-time-and-json-checks.xml.
    -->
    <include file="db/changelog/changes/039-step-response-time-and-json-checks.xml"/>

    <!--
        Autorite de certification TLS propre a une application - voir changes/040-application-tls-ca.xml.
    -->
    <include file="db/changelog/changes/040-application-tls-ca.xml"/>

    <!--
        Metriques calculees sur les resultats (table metric en fin de vie, conservee) et index sur la date
        des resultats - voir changes/041-metric-from-results.xml.
    -->
    <include file="db/changelog/changes/041-metric-from-results.xml"/>

</databaseChangeLog>

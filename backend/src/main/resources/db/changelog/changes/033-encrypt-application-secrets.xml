<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Correction P1 - secrets des applications testees chiffres en base (AES-256-GCM, voir
        security.SecretCipher et docs/SECRETS.md) :
          application.auth_config       jeton, cle API, mot de passe Basic, corps de connexion ;
          application.monitoring_secret jeton ou valeur d'en-tete du monitoring.

        1. Colonnes elargies : une valeur chiffree (prefixe + Base64 de l'IV et du texte chiffre)
           est environ 1,35 fois plus longue que le texte en clair.
        2. Les valeurs deja presentes sont chiffrees avec la cle LOADPILOT_SECRETS_KEY ;
           null et vide restent tels quels.
    -->
    <changeSet id="033-1-widen-secret-columns" author="loadpilot">
        <modifyDataType tableName="application" columnName="auth_config" newDataType="VARCHAR(20000)"/>
        <modifyDataType tableName="application" columnName="monitoring_secret" newDataType="VARCHAR(8000)"/>
    </changeSet>

    <changeSet id="033-2-encrypt-existing-secrets" author="loadpilot">
        <customChange class="com.loadpilot.backend.config.EncryptApplicationSecretsChange"/>
    </changeSet>

</databaseChangeLog>

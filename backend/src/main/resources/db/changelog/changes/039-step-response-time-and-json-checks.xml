<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Controles optionnels d'une etape (voir service.execution.StepChecks) : colonnes ADDITIONNELLES et
        NULLABLES. NULL = controle absent, comme avant.

        step.max_response_time_ms    : temps de reponse maximal (ms) ; au-dela, l'etape echoue.
        step.assertion_json_path     : champ JSON a verifier (meme syntaxe que la capture, ex. $.status).
        step.assertion_json_operator : EQUALS (egale) ou CONTAINS (contient).
        step.assertion_json_value    : valeur attendue.
    -->
    <changeSet id="039-step-response-time-and-json-checks" author="loadpilot">
        <addColumn tableName="step">
            <column name="max_response_time_ms" type="INT"/>
            <column name="assertion_json_path" type="VARCHAR(500)"/>
            <column name="assertion_json_operator" type="VARCHAR(16)"/>
            <column name="assertion_json_value" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>

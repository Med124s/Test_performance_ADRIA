<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Resultat detaille du dernier test de connectivite, pour l'afficher
        dans la liste sans relancer de test - colonnes ADDITIONNELLES et
        NULLABLES uniquement.

        application.status_message    : message lisible du dernier test
                                        (jamais de secret).
        application.status_checked_at : date du dernier test ; null quand
                                        aucun test n'est valide (jamais teste,
                                        ou modifie depuis le dernier test).
    -->
    <changeSet id="016-add-application-status-message" author="loadpilot">
        <addColumn tableName="application">
            <column name="status_message" type="VARCHAR(1000)"/>
            <column name="status_checked_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>

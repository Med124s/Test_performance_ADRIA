<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Planification complete :
        - execution.schedule_id : planification a l'origine de l'execution (historique) ; pas de cle
          etrangere, comme last_execution_id : supprimer une planification ne touche jamais ses executions ;
        - scheduled_execution.end_at : date de fin optionnelle d'une planification recurrente ;
        - scheduled_execution.notify_mode : ALWAYS (chaque fin) ou PROBLEMS (echec ou regression) ;
        - scheduled_run_event : lancements prevus mais non lances (ignores, manques, refuses), avec leur raison.
    -->
    <changeSet id="028-schedule-history-and-rules" author="loadpilot">
        <addColumn tableName="execution">
            <column name="schedule_id" type="UUID"/>
        </addColumn>
        <createIndex indexName="idx_execution_schedule_started" tableName="execution">
            <column name="schedule_id"/>
            <column name="started_at"/>
        </createIndex>

        <addColumn tableName="scheduled_execution">
            <column name="end_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="notify_mode" type="VARCHAR(20)" defaultValue="ALWAYS">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createTable tableName="scheduled_run_event">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="schedule_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_run_event_schedule"
                             references="scheduled_execution(id)" deleteCascade="true"/>
            </column>
            <column name="planned_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_run_event_schedule_planned" tableName="scheduled_run_event">
            <column name="schedule_id"/>
            <column name="planned_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

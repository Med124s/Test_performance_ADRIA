<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Phase 6 - table application. cree_par (created_by) reference
        app_user(id) (voir 001-create-app-user.xml, inclus avant celui-ci
        dans le changelog maitre).
    -->
    <changeSet id="002-create-application" author="loadpilot">
        <createTable tableName="application">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="url" type="VARCHAR(2048)">
                <constraints nullable="false"/>
            </column>
            <column name="monitoring_url" type="VARCHAR(2048)"/>
            <column name="status" type="VARCHAR(20)"/>
            <column name="created_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_application_created_by"
                             references="app_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>

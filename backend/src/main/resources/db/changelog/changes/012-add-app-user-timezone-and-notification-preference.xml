<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Phase P1-D - Configurations/Settings/Environments reels (voir
        rapport dedie). Les changesets historiques 001-011 ne sont PAS
        modifies (deja executes) : cette migration ADDITIONNELLE ajoute une
        seule colonne nullable et une seule nouvelle table.

        app_user.timezone : preference REELLE de l'utilisateur (voir
        entity.AppUser) - jamais ecrasee par AppUserSyncService.sync.
        Nullable, aucune valeur par defaut fabriquee.

        notification_preference : voir entity.NotificationPreference -
        modele "opt-out" (absence de ligne = active), FK vers app_user.

        AUCUNE table "Environment"/"Configuration"/"Settings" generique
        n'est creee ici - decision explicite documentee dans le rapport
        P1-D (aucun besoin metier reel demontre dans le code existant pour
        un environnement multi-URL par Application, et une table
        cle/valeur generique est explicitement interdite par le prompt).
    -->
    <changeSet id="012-add-app-user-timezone" author="loadpilot">
        <addColumn tableName="app_user">
            <column name="timezone" type="VARCHAR(60)"/>
        </addColumn>
    </changeSet>

    <changeSet id="012-create-notification-preference" author="loadpilot">
        <createTable tableName="notification_preference">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="app_user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_notification_preference_app_user" references="app_user(id)"/>
            </column>
            <column name="notification_type" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="notification_preference"
                              columnNames="app_user_id, notification_type"
                              constraintName="uq_notification_preference_user_type"/>
    </changeSet>

</databaseChangeLog>
